# AutoSfera AI — single-dealer pilot
DEALER_ID=main-salon
DEALER_NAME=AutoSfera Demo Salon
DATABASE_PATH=data/autosfera.db
# Local Python keeps SQLite when this value is empty. Docker Compose assembles
# the PostgreSQL URL from POSTGRES_PASSWORD below.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_PASSWORD=replace-with-strong-database-password
APP_PORT=8000
LLM_MODE=mock
ORCHESTRATOR_MODE=langgraph
# Safe default. For RAG 2.0 set pgvector, run migrations, then index explicitly.
RAG_BACKEND=tfidf
EMBEDDING_MODE=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=64
RAG_TOP_K=6
# Calibrate on evaluation queries; 0.30 is only a pilot starting point.
RAG_MIN_SCORE=0.05
RAG_VECTOR_MIN_SCORE=0.30
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160
LOG_LEVEL=INFO
# Replace every demo secret before any public deployment.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_MINUTES=480
DEMO_ADMIN_PASSWORD=replace-admin-password
DEMO_EMPLOYEE_PASSWORD=replace-employee-password
DEMO_SALES_PASSWORD=replace-sales-password
DEMO_SERVICE_PASSWORD=replace-service-password
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RESEARCH_WEBHOOK_URL=
RESEARCH_WEBHOOK_SECRET=replace-research-webhook-secret
RESEARCH_TIMEOUT_SECONDS=15
ACTION_GATEWAY_MODE=mock
ACTION_WEBHOOK_URL=
ACTION_WEBHOOK_SECRET=replace-action-webhook-secret
ACTION_TIMEOUT_SECONDS=10
ACTION_MAX_ATTEMPTS=3
ACTION_CALLBACK_URL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6
