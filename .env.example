# AutoSfera AI — single-dealer pilot
DEALER_ID=main-salon
DEALER_NAME=AutoSfera Demo Salon
DATABASE_PATH=data/autosfera.db
LLM_MODE=mock
LOG_LEVEL=INFO
# Replace every demo secret before any public deployment.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_MINUTES=480
DEMO_ADMIN_PASSWORD=replace-admin-password
DEMO_EMPLOYEE_PASSWORD=replace-employee-password
DEMO_SALES_PASSWORD=replace-sales-password
DEMO_SERVICE_PASSWORD=replace-service-password
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RESEARCH_WEBHOOK_URL=
RESEARCH_WEBHOOK_SECRET=replace-research-webhook-secret
RESEARCH_TIMEOUT_SECONDS=15
