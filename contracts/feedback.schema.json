{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosfera.example/contracts/feedback.schema.json",
  "title": "AutoSfera beta feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "rating"],
  "properties": {
    "session_id": {"type": "string", "minLength": 4, "maxLength": 160},
    "rating": {"type": "integer", "minimum": 1, "maximum": 5},
    "comment": {"type": ["string", "null"], "maxLength": 1000}
  }
}
