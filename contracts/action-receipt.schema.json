{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosfera.example/contracts/action-receipt.schema.json",
  "title": "AutoSfera ActionReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "job_id", "trace_id", "status"],
  "properties": {
    "accepted": {"type": "boolean"},
    "job_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "duplicate", "rejected"]},
    "received_at": {"type": ["string", "null"]}
  }
}
