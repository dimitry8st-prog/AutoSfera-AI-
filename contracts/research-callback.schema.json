{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosfera.ai/contracts/research-callback.schema.json",
  "title": "AutoSfera research callback",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "dealer_id", "trace_id", "result", "sources"],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "dealer_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "format": "uuid"},
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "summary"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "summary": {"type": "string", "minLength": 1, "maxLength": 30000}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "title": {"type": "string", "maxLength": 500},
          "url": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
